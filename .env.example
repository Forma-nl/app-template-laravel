# Everything the portal manages is injected as an environment variable from the
# SOPS-encrypted secret, so this file only documents what an app expects. It is
# never the place to put a real credential.
APP_NAME="My application"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.apps.forma.nl

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Set by the portal: the CNPG cluster for this environment.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Set by the portal when the Valkey component is on.
REDIS_HOST=
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Set by the portal when the S3 component is on; the bucket is per environment.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail goes out over the installation's relay unless the app overrides it.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
